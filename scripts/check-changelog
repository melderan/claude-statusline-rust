#!/usr/bin/env bash
# A change to the code needs a line under [Unreleased] in CHANGELOG.md.
# Usage: scripts/check-changelog BASE HEAD      (two commits; exit 1 when an entry is missing)
set -euo pipefail

[ $# -eq 2 ] || { sed -n '2,3p' "$0" | sed 's/^# //'; exit 2; }
base="$1"; head="$2"
cd "$(git rev-parse --show-toplevel)"

changed="$(git diff --name-only "$base" "$head")"
if ! printf '%s\n' "$changed" | grep -qE '^(src/|tests/|Cargo\.toml$)'; then
  echo "check-changelog: no code change between ${base:0:7} and ${head:0:7}; no entry needed"
  exit 0
fi
if ! printf '%s\n' "$changed" | grep -qx 'CHANGELOG.md'; then
  echo "check-changelog: FAIL code changed but CHANGELOG.md did not; add your lines under [Unreleased] (VERSIONING.md), or label the pull request no-changelog" >&2
  exit 1
fi
added="$(git diff "$base" "$head" -- CHANGELOG.md | grep -cE '^\+- ' || true)"
if [ "$added" -eq 0 ]; then
  echo "check-changelog: FAIL CHANGELOG.md changed but no entry line (starting with '- ') was added" >&2
  exit 1
fi
echo "check-changelog: ok, CHANGELOG.md gained $added entry line(s) for the code change"
